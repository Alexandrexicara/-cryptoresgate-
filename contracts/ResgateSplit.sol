pragma solidity ^0.8.24;

/**
 * @title ResgateSplit
 * @notice Experimental native-coin split payment, not a recovery or custody tool.
 * @dev Deploy only to a testnet until independently audited.
 *      The payer explicitly submits a payment; funds are split immediately.
 */
contract ResgateSplit {
    address payable public immutable serviceRecipient;
    address payable public immutable clientRecipient;

    event SplitPaid(
        bytes32 indexed caseId,
        address indexed payer,
        address indexed client,
        uint256 totalAmount,
        uint256 serviceAmount,
        uint256 clientAmount
    );

    error ZeroAddress();
    error InvalidCaseId();
    error ZeroPayment();
    error TransferFailed();

    constructor(address payable service_, address payable client_) {
        if (service_ == address(0) || client_ == address(0)) revert ZeroAddress();
        if (service_ == client_) revert ZeroAddress();
        serviceRecipient = service_;
        clientRecipient = client_;
    }

    /**
     * @notice Payer voluntarily sends native coin for an identified case.
     * @param caseId Non-identifying case reference generated by the application.
     * @dev Service receives floor(amount / 2); client receives the remainder.
     *      The caller must have accepted the service agreement off-chain first.
     */
    function payAndSplit(bytes32 caseId) external payable {
        if (caseId == bytes32(0)) revert InvalidCaseId();
        if (msg.value == 0) revert ZeroPayment();

        uint256 serviceAmount = msg.value / 2;
        uint256 clientAmount = msg.value - serviceAmount;

        (bool serviceOk, ) = serviceRecipient.call{value: serviceAmount}("");
        if (!serviceOk) revert TransferFailed();

        (bool clientOk, ) = clientRecipient.call{value: clientAmount}("");
        if (!clientOk) revert TransferFailed();

        emit SplitPaid(
            caseId,
            msg.sender,
            clientRecipient,
            msg.value,
            serviceAmount,
            clientAmount
        );
    }

    // Intentionally no receive(), fallback(), arbitrary withdrawal, or owner override.
}
