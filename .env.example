# Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/cryptoresgate

# NVIDIA NIM / API — configure no servidor; nunca exponha no navegador
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# Blockchain monitoring (somente leitura). Redes EVM usam RPCs públicos sem chave por padrão; variáveis abaixo sobrescrevem.
EVM_RPC_URL= # compatibilidade com a rede indicada em EVM_NETWORK
EVM_NETWORK=ethereum
ETHEREUM_RPC_URL= # opcional; se vazio, usa EVM_RPC_URL quando EVM_NETWORK=ethereum
BSC_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
SOLANA_RPC_URL= # opcional; RPC Solana próprio, com provedores públicos alternativos automáticos

# WalletConnect / frontend — preencher somente após registrar o projeto
WALLETCONNECT_PROJECT_ID=

# Notifications — opcional; usar somente contatos fornecidos/consentidos pelo titular
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
CONTACT_ENCRYPTION_KEY=
OPERATOR_API_KEY=
PUBLIC_APP_URL=https://cryptoresgate.netlify.app

# Application security
APP_SECRET_KEY=

# CORS: informe as origens exatas do frontend, separadas por virgula
CORS_ORIGINS=http://localhost:5173
