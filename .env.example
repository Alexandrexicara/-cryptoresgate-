# Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/cryptoresgate

# NVIDIA NIM / API — configure no servidor; nunca exponha no navegador
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# Blockchain monitoring (somente endpoints públicos/read-only)
EVM_RPC_URL=
EVM_NETWORK=ethereum
CHAIN_ID=

# WalletConnect / frontend — preencher somente após registrar o projeto
WALLETCONNECT_PROJECT_ID=

# Notifications — opcional; usar somente contatos fornecidos/consentidos pelo titular
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_FROM=

# Application security
APP_SECRET_KEY=

# CORS: informe as origens exatas do frontend, separadas por virgula
CORS_ORIGINS=http://localhost:5173
